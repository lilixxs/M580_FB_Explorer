{
  "name": "m580-fb-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "description": "Browser-based Schneider M580 function block exchange file explorer",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "monaco-editor": "^0.52.2",
    "tdesign-vue-next": "^1.10.7",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.10"
  }
}
